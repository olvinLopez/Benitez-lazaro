meta {
  name: 5 - PATCH estado con token de luis (moderador)
  type: http
  seq: 5
}

patch {
  url: {{base}}/comentarios/6/estado
  body: json
  auth: none
}

body:json {
  { "estado": "aprobado" }
}

assert {
  res.status: eq 200
}

script:pre-request {
  const axios = require("axios");
  const r = await axios.post(bru.getEnvVar("base") + "/login", { usuario: "luis", clave: "luis-2026" });
  req.setHeader("Authorization", "Bearer " + r.data.token);
}
